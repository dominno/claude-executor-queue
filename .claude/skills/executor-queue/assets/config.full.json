{
  "keep_busy": [],
  "paused": [],
  "limits": {
    "codex": 2,
    "agy": 1
  },
  "min_free_gb": 5,
  "max_load_per_cpu": 1.0,
  "main": "main",
  "context_files": [
    "AGENTS.md"
  ],
  "brief_lint": {
    "mode": "warn",
    "restricted": [],
    "handoff_marker": "lead runs",
    "fields": {},
    "result_max_words": 45,
    "max_steps": 4,
    "notes_require_file": false
  },
  "scope_check": "warn",
  "stale_base": "warn",
  "ledger": ".agents/ledger.jsonl",
  "import_map": {
    "id": "task_id",
    "executor": "agent",
    "status": "state",
    "brief": "brief_path",
    "ts": "timestamp",
    "status_values": {
      "complete": "done",
      "error": "failed",
      "active": "running",
      "archived": "closed"
    },
    "event": "kind",
    "verdict": "verdict",
    "by": "reader",
    "commit": "merge_sha",
    "model": "model",
    "effort": "effort",
    "event_values": {
      "started": "assign",
      "ended": "finish",
      "checked": "verify",
      "landed": "merge",
      "retired": "close"
    }
  },
  "extra_checks_timeout": "20s"
}
