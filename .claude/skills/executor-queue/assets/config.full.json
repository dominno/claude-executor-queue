{
  "keep_busy": [],
  "paused": [],
  "limits": {
    "codex": 2,
    "agy": 1
  },
  "min_free_gb": 5,
  "max_load_per_cpu": 1.0,
  "main": "main",
  "context_files": [
    "AGENTS.md"
